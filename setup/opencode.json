{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:7b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local, no tokens)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": { "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B" } }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "gh *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "sendmail*": "deny",
      "mail *": "deny",
      "npm publish*": "deny",
      "pip install*": "deny",
      "npm install*": "deny",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny"
    }
  }
}
